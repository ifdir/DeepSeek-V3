+# Rust migration source work; no Python fallback.
+def _native_boundary(conn, row, operation, payload, **options):
+    from matrix_api.native_boundary import NativeBoundaryError, validate
+    # Send only referenced identities, not the entire session history on every
+    # row. Intersection is with the existing server-owned SQL/cache indexes.
+    # This is a transport projection, not a client-supplied permission list.
+    candidate_ids = set()
+    pending = [payload, options]
+    seen = set()
+    count = 0
+    while pending:
+        value = pending.pop()
+        count += 1
+        if count > 1_000_000:
+            raise WriterError("Native identity projection exceeds transport limit", 503, "NATIVE_FRAME_LIMIT")
+        if isinstance(value, str):
+            candidate_ids.add(value)
+        elif isinstance(value, (dict, list, tuple)):
+            identity = id(value)
+            if identity in seen:
+                continue
+            seen.add(identity)
+            pending.extend(value.values() if isinstance(value, dict) else value)
+    context = {
+        "user_id": str(row["user_id"]),
+        "world_id": str(row["world_id"]),
+        "session_id": str(row["id"]),
+        "cast": sorted(_session_cast_ids(conn, row) & candidate_ids),
+        "operators": sorted(_operator_ids()),
+        "sources": {},
+    }
+    if operation in ("fact", "sources", "relation", "witness"):
+        context["sources"] = {kind: sorted(ids & candidate_ids) for kind, ids in _session_sources(conn, row).items()}
+    if operation == "god":
+        from matrix_api import kernel as _kernel
+        src = str(payload.get("sourceTurnId") or payload.get("source_turn_id") or "")
+        context["god_truth_id"] = src
+        context["god_truth"] = _turn_truth_row(conn, row["id"], src) if src else None
+        context["god_axes"] = _kernel.god_scope_axes(_kernel._god_scope_key(str(payload.get("scope") or "")))
+    try:
+        validate(operation, context, payload, options)
+    except NativeBoundaryError as exc:
+        raise WriterError(exc.message, exc.status, exc.code) from exc
